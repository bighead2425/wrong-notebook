# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfoconfig
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma


# App config (contains secrets)
/config/app-config.json
dist-scripts

# Playwright
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# Local Database
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# Logs & Output
*.log
test_output*.txt
upload_test_output*.txt

# data
/data/
.next-prebuilt/

# 打样产物（会包含真实题目的渲染结果，不得提交）
/scripts/print-sample/out/

# 词表重建的指纹文件（本地重建脚本生成，线上放在数据卷里）
# 提交它会让容器以为"词表已同步"而跳过重建
prisma/.tags_hash
*.tags_hash
