// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  // 登录用户名：登录页用「用户名 + 密码」，故必须唯一（邮箱降级为可选用途）
  name      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  educationStage String? // primary, junior_high, senior_high, university
  enrollmentYear Int?

  role      String   @default("user") // "admin" or "user"
  isActive  Boolean  @default(true)   // 用户是否启用

  errorItems ErrorItem[]
  notebooks  Notebook[]
  practiceRecords PracticeRecord[]
  customTags KnowledgeTag[] // User's custom tags
  printBatches PrintBatch[] // 打印批次（一次交付 = 一批）
}

// 统一知识点标签表 (支持无限层级)
model KnowledgeTag {
  id        String   @id @default(cuid())
  name      String   // 标签名，如 "勾股定理"
  subject   String   // 学科，如 "math", "english"

  // 层级控制 (邻接表模式)
  parentId  String?
  parent    KnowledgeTag?  @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  KnowledgeTag[] @relation("TagHierarchy")

  // 排序与编码
  order     Int      @default(0) // 用于保持教材顺序
  code      String?              // 如 "1.2.1"

  // 区分系统预设 vs 用户自定义
  isSystem  Boolean  @default(false)
  userId    String?  // 如果是用户自定义标签，绑定 userId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 与错题的多对多关系
  errorItems ErrorItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 联合索引：确保同一用户（或系统）下同一父节点下的标签名不重复
  @@unique([subject, name, userId, parentId])
  // 索引：加速父子查询
  @@index([parentId])
  @@index([subject])
}

/// 教科书级错题本（B13：一本教科书 = 一个错题本，如「小五上数学」）
/// 学科 / 学期 / 年级 / 学段四结构化字段在此承载，ErrorItem 不再重复存。
/// 注意：SQLite 不支持 Prisma enum，以下枚举类字段一律用 String 存，取值见注释。
model Notebook {
  id          String @id @default(cuid())

  // 四结构化字段（Q1）
  gradeStage  String @default("primary") // 学段: primary(小学) / junior(初中) / senior(高中)
  grade       String @default("")        // 年级: 如 "五年级"
  semester    String @default("上")      // 学期: 上 / 下
  subject     String @default("math")    // 学科 subjectKey: math/chinese/english/physics/chemistry/biology/politics/history/geography/other
                                          // ⚠️ 题号生成直接读此字段，不再从显示名反推（5.5）

  displayName String                     // 自由显示名，如 "小五上数学"（B14）

  // 归档状态（H2 四分法 · 归档是本级操作，5.3：题不自持归档标记）
  archiveStatus String @default("active") // active(在用) / archived(已归档)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  errorItems ErrorItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([displayName, userId])
  @@index([userId])
  @@index([subject])
  @@index([archiveStatus])
}

model ErrorItem {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebookId     String?
  notebook       Notebook? @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  originalImageUrl String
  ocrText          String?
  
  // AI Analysis
  questionText     String? // Parsed question
  answerText       String? // AI provided answer
  analysis         String? // AI analysis/explanation
  wrongAnswerText  String? // [Q4/G6 已弃用·保留列停止写入] 错答直接从原图看，T11 拍板保留列不删
  mistakeAnalysis  String? // Analysis of why the wrong answer happened
  mistakeStatus    String? // not_attempted, wrong_attempt, unknown
  knowledgePoints  String? // [DEPRECATED] JSON string - kept for migration only
  
  // New: many-to-many relation with KnowledgeTag
  tags             KnowledgeTag[]
  
  // User Metadata
  source           String? // e.g. "Midterm Exam"
  errorType        String? // e.g. "Calculation", "Concept"
  userNotes        String?

  /// 【M0 新增】AI 统一打标的错因分类（P16：她自由书写，AI 归类）。
  /// ⚠️ 刻意与 errorType 分开：那个是**外部导入透传**的英文自由文本（api/import、
  /// openclaw/batch-upload 会写），语义不受控；本列只装**受控枚举**，取值见
  /// src/lib/mistake-category.ts。一个字段只担一种语义，避免"不报错只静默错"。
  mistakeCategory  String?
  
  masteryLevel     Int     @default(0) // 0: New, 1: Reviewing, 2: Mastered（5.3：=2 即四分法「已掌握」）
  gradeSemester    String? // [遗留·不再写入] 年级学期由 Notebook 承载，保留列仅为兼容旧数据
  paperLevel       String? // e.g. "A", "B", "Other"

  // ===== 状态字段（5.3 单一事实来源，禁止再造冗余态）=====
  printCount       Int       @default(0)  // 打印次数，只显不改（#10 / T4）
  attention        Int       @default(1)  // 关注档 1-5，语义=难度档（G8 / T5）
  redoCount        Int       @default(0)  // 复做计次，扫码复做 +1（H1 不闭环 / T7）
  mergeSource      String?               // 合并来源原题号组（#14 / T6）
  deletedAt        DateTime?             // 软删标记，非空=在回收箱（H2 / T2）
  lastPrintedAt    DateTime?             // 最近打印时间（#10）
  inputMethod      String?               // 录入方式: photo(拍照) / album(相册) / manual(手动)（H4）
                                          // ⚠️ 与上面 source(试卷来源) 不是一回事，勿混用

  /// 【M0 增补 → M3 落地】框坐标落库（P7「存坐标、不烧像素」）。
  /// 形状：
  ///   {"boxes":[{"kind":"scope|question|handwriting|figure","x":..,"y":..,"w":..,"h":..}],
  ///    "base":{"w":..,"h":..,"rotation":0|90|180|270}}
  /// kind 四种对应录入时的四色框：scope=绿（作用域）/ question=红（题干）/
  /// handwriting=蓝（她的手写）/ figure=橙（题图，不可 OCR）。取值见 src/lib/crop-regions.ts。
  ///
  /// ⚠️ 坐标**必须连基准图宽高 + 旋转一起存**（`base`）：图片一旦旋转或拉伸，坐标系就换了。
  ///    只存 x/y/w/h、不存基准尺寸，迟到一次旋转就会「不报错、只画错」
  ///    （同 image-cropper.tsx 的 rectSpaceStaleRef 教训：宁可没标记，也不要错的框）。
  ///
  /// 存坐标而不是把框烧进像素的收益：一张原图 + 一份坐标可派生
  /// **正面图 / 净版 / 题图 / OCR 输入** 四种视图，且原图永远干净。
  /// 反面印的「净版」= 按 handwriting / figure 的坐标涂白（M2 主路，确定性操作）。
  cropRegions      String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reviewSchedules ReviewSchedule[]
  printJobs       PrintJob[]        // 该题的每一次打印（同一题会重印多次，见 PrintJob）
  stateChangeLogs StateChangeLog[]  // 状态变更日志（R15）

  @@index([notebookId])
  @@index([deletedAt])
  @@index([userId, createdAt])
}

model ReviewSchedule {
  id          String    @id @default(cuid())
  errorItemId String
  errorItem   ErrorItem @relation(fields: [errorItemId], references: [id], onDelete: Cascade)

  /// 【M0 新增】第几轮独立检查（R14：1 = 第 0 天首次深挖 / 2 = 第 7 天 / 3 = 第 21 天）。
  /// ⚠️ 刻意**不加** @@unique([errorItemId, round])：存量数据由 /api/import 写入，
  /// 其去重口径是「同一 errorItem + 相同 scheduledFor」（import/route.ts:341 用 findFirst 而非 upset 去重），
  /// 说明库里可能存在同题多条记录。加唯一约束会让 SQLite 重建整表，风险大于收益。
  /// 唯一性改由 M7 的写入侧保证。
  round       Int       @default(1)

  scheduledFor DateTime
  completedAt  DateTime?
  isCorrect    Boolean? // Result of the review

  /// 【M0 新增】该轮用哪张纸（第 7 / 21 天走 T0 极简重做卡），以及她做完扫回来的那一面
  printJobId   String?
  scanReturnId String?

  createdAt    DateTime @default(now())

  @@index([errorItemId, round])
  @@index([scheduledFor])
}

model PracticeRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subject   String?  // e.g. "Math", "Physics"
  difficulty String? // "easy", "medium", "hard", "harder"
  isCorrect Boolean?
  
  createdAt DateTime @default(now())
}

// ============================================================================
// 【M0 · 2026-09-24】纸面回流链的数据底座（设计依据：打印结论 P19–P25）
//
// 为什么需要这一组表：
// 旧模型只有 ErrorItem.printCount 一个计数器 —— 知道"这题印过 3 次"，
// 却**不知道每一张纸各自是什么**。而新规范要求二维码里带"第几次打印 + 哪一面"
// （P25.1，如 SX20260916001-R2-B），扫回来还要落到具体的某一面纸上。
// 计数器做不到这件事，所以要补"打印实例"这一层。
//
// 依赖方向：PrintBatch（一批交付）→ PrintJob（一次打印）→ ScanReturn（扫回来的一面）。
// ============================================================================

/// 打印批次：一次交付即一批（P23 / R4：hill 的动作永远可分批）。
model PrintBatch {
  id          String @id @default(cuid())

  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 本批是否含 T5 回信页（回信随下一批卡交付，R7）
  hasReplyPage Boolean @default(false)

  /// 本批题数（冗余列，供列表直显；以 printJobs 关系为权威）
  itemCount   Int      @default(0)

  printedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  printJobs   PrintJob[]

  @@index([userId, printedAt])
}

/// 打印实例：一道题每被打印一次，产生一条。
model PrintJob {
  id          String    @id @default(cuid())

  errorItemId String
  errorItem   ErrorItem @relation(fields: [errorItemId], references: [id], onDelete: Cascade)

  /// 题号快照（= ErrorItem.source，如 SX20260916001）。二维码里印的就是它。
  /// 存快照的理由：合并错题会改 source（api/error-items/merge），
  /// 日后核对"当年那张纸上印的是什么"只能靠快照。
  questionNo  String

  /// 该题第几次打印：R1 / R2 / R3 …
  /// ⚠️ 与 ErrorItem.printCount 的关系：printCount 是"计数缓存"，本列是权威。
  /// 建实例时两者在**同一事务内**同步递增，避免漂移。
  instanceNo  Int

  /// 纸型（T1–T5）：本轮只实现 T1 深挖纸；T0 极简重做卡（第 7/21 天）预留
  paperType   String @default("T1")

  /// 这一张纸的用途：initial(第 0 天首次深挖) / day7 / day21
  /// ⚠️ 与 paperType 分开：T0 既能用于 day7 也能用于 day21，两者不是一回事
  stage       String @default("initial")

  batchId     String?
  batch       PrintBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  printedAt   DateTime @default(now())

  /// 回收状态。软件**只记它确实知道的两件事**：
  ///   printed  = 已打印（纸进了待做匣。她做没做，软件不猜 —— R16 不监控）
  ///   returned = 已回收（hill 扫回来了。R18：没她痕迹的纸不扫，也就不会有这条流转）
  /// 中间的"她正在做"刻意不存在。
  status      String @default("printed")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scanReturns ScanReturn[]

  /// 同一题的同一实例号只能有一条
  @@unique([errorItemId, instanceNo])
  @@index([batchId])
  @@index([status])
}

/// 回收件：扫描回来的**一面**纸（P25：两面各印一个码，故按面分别入库）。
model ScanReturn {
  id         String   @id @default(cuid())

  printJobId String
  printJob   PrintJob @relation(fields: [printJobId], references: [id], onDelete: Cascade)

  /// 哪一面：F = 正面（反思面）/ B = 背面（重做面）
  side       String

  /// 扫描件地址。**原件优先**（R17：AI 优先看扫描图，OCR 只是省力副本）
  imageUrl   String
  ocrText    String?

  scannedAt  DateTime @default(now())

  /// AI 判定结果（波 3 才写入，M0 只建位）
  aiVerdict  String?  // 已掌握 / 仍有错 / 无法判定
  aiPayload  String?  // 结构化原始结果（JSON 字符串）

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// 同一实例的同一面只应有一条。
  /// 重复扫到同一面时**撞唯一约束报错**，而不是静默覆盖 ——
  /// 正是 P25.5 要求的"报警交人确认，不做静默覆盖"。
  /// （污损重扫的更新路径留给波 2）
  @@unique([printJobId, side])
  @@index([printJobId])
}

/// 状态变更日志（R15）：哪道题、什么时候、被谁、标成了什么。
/// 原则：记**状态变更**，不记学习行为；按需查，不做全量监控（R16）。
model StateChangeLog {
  id           String    @id @default(cuid())

  errorItemId  String
  errorItem    ErrorItem @relation(fields: [errorItemId], references: [id], onDelete: Cascade)

  /// 变更的字段：masteryLevel / deletedAt / mistakeCategory …
  field        String
  fromValue    String?
  toValue      String?

  /// 谁改的：user / ai / scan / system
  actor        String
  actorUserId  String?

  /// 追到是哪张纸触发的（可空：在电脑上手动勾选就没有纸）
  printJobId   String?
  scanReturnId String?

  note         String?
  createdAt    DateTime @default(now())

  @@index([errorItemId, createdAt])
  @@index([actor, createdAt])
}
