// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  // 登录用户名：登录页用「用户名 + 密码」，故必须唯一（邮箱降级为可选用途）
  name      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  educationStage String? // primary, junior_high, senior_high, university
  enrollmentYear Int?

  role      String   @default("user") // "admin" or "user"
  isActive  Boolean  @default(true)   // 用户是否启用

  errorItems ErrorItem[]
  notebooks  Notebook[]
  practiceRecords PracticeRecord[]
  customTags KnowledgeTag[] // User's custom tags
  printBatches PrintBatch[] // 打印批次（一次交付 = 一批）
  insights   Insight[]      // 【2026-10-01】日积月累条目
}

// 统一知识点标签表 (支持无限层级)
model KnowledgeTag {
  id        String   @id @default(cuid())
  name      String   // 标签名，如 "勾股定理"
  subject   String   // 学科，如 "math", "english"

  // 层级控制 (邻接表模式)
  parentId  String?
  parent    KnowledgeTag?  @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  KnowledgeTag[] @relation("TagHierarchy")

  // 排序与编码
  order     Int      @default(0) // 用于保持教材顺序
  code      String?              // 如 "1.2.1"

  // 区分系统预设 vs 用户自定义
  isSystem  Boolean  @default(false)
  userId    String?  // 如果是用户自定义标签，绑定 userId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 与错题的多对多关系
  errorItems ErrorItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 联合索引：确保同一用户（或系统）下同一父节点下的标签名不重复
  @@unique([subject, name, userId, parentId])
  // 索引：加速父子查询
  @@index([parentId])
  @@index([subject])
}

/// 教科书级错题本（B13：一本教科书 = 一个错题本，如「小五上数学」）
/// 学科 / 学期 / 年级 / 学段四结构化字段在此承载，ErrorItem 不再重复存。
/// 注意：SQLite 不支持 Prisma enum，以下枚举类字段一律用 String 存，取值见注释。
model Notebook {
  id          String @id @default(cuid())

  // 四结构化字段（Q1）
  gradeStage  String @default("primary") // 学段: primary(小学) / junior(初中) / senior(高中)
  grade       String @default("")        // 年级: 如 "五年级"
  semester    String @default("上")      // 学期: 上 / 下
  subject     String @default("math")    // 学科 subjectKey: math/chinese/english/physics/chemistry/biology/politics/history/geography/other
                                          // ⚠️ 题号生成直接读此字段，不再从显示名反推（5.5）

  displayName String                     // 自由显示名，如 "小五上数学"（B14）

  // 归档状态（H2 四分法 · 归档是本级操作，5.3：题不自持归档标记）
  archiveStatus String @default("active") // active(在用) / archived(已归档)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  errorItems ErrorItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([displayName, userId])
  @@index([userId])
  @@index([subject])
  @@index([archiveStatus])
}

model ErrorItem {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebookId     String?
  notebook       Notebook? @relation(fields: [notebookId], references: [id], onDelete: Cascade)

  originalImageUrl String
  ocrText          String?
  
  // AI Analysis
  questionText     String? // Parsed question
  answerText       String? // AI provided answer
  analysis         String? // AI analysis/explanation
  wrongAnswerText  String? // [Q4/G6 已弃用·保留列停止写入] 错答直接从原图看，T11 拍板保留列不删
  mistakeAnalysis  String? // Analysis of why the wrong answer happened
  mistakeStatus    String? // not_attempted, wrong_attempt, unknown
  knowledgePoints  String? // [DEPRECATED] JSON string - kept for migration only
  
  // New: many-to-many relation with KnowledgeTag
  tags             KnowledgeTag[]
  
  // User Metadata
  source           String? // e.g. "Midterm Exam"
  errorType        String? // e.g. "Calculation", "Concept"
  userNotes        String?

  /// 【M0 新增】AI 统一打标的错因分类（P16：她自由书写，AI 归类）。
  /// ⚠️ 刻意与 errorType 分开：那个是**外部导入透传**的英文自由文本（api/import、
  /// openclaw/batch-upload 会写），语义不受控；本列只装**受控枚举**，取值见
  /// src/lib/mistake-category.ts。一个字段只担一种语义，避免"不报错只静默错"。
  mistakeCategory  String?
  
  masteryLevel     Int     @default(0) // 0: New, 1: Reviewing, 2: Mastered（5.3：=2 即四分法「已掌握」）
  gradeSemester    String? // [遗留·不再写入] 年级学期由 Notebook 承载，保留列仅为兼容旧数据
  paperLevel       String? // e.g. "A", "B", "Other"（[2026-09-28 起界面不再用：被 manageType 取代] 保留列以免动老数据）

  /// 【2026-09-28 新增】**错题等级** =「这道题怎么处置」：deep（深挖）/ review（复练）。
  ///
  /// ⚠️ **只有两个值** —— 「积累」**不在这一层**：自己手输的积累点背后没有错题行，
  /// 没有地方存这个值；积累是**另一种内容**，将来自立一张表（见二次设计《阅读入口》§6.2
  /// 标记为"必改"的死结）。
  ///
  /// NULL = **未定**（老数据与"还没定过的题"）。界面显示为"未定"，不猜、不默认写死。
  manageType       String? // deep | review

  /// 这个等级是**怎么来的**：default（录入默认）/ derived（按错因派生）/ ai（采纳 AI 建议）/
  /// manual（人手动定的）/ upgrade（行为自动升）。
  ///
  /// 用来实现定稿的「**派生 + 落定快照**」：错因以后变了，**只允许自动改写
  /// default / derived 的行**；manual / upgrade **一律不动**（避免静默重分历史数据）。
  /// 每次变更还要写 StateChangeLog。
  manageTypeSource String? // default | derived | ai | manual | upgrade

  /// 【2026-10-03 需求第 10 条】**深挖纸的随机 emoji 标识**（印在页眉"印于"左边）。
  ///
  /// 与纸上的编号二维码同理：它是**这道题这张深挖纸的属性** —— 重新打印同一张纸，
  /// 符号不变（NULL 时惰性生成一次并写回）。深挖纸**只有正面**有印刷时间，所以只给一个。
  /// 取值只能来自 `src/lib/emoji-print-library.json`（等概率随机，见 `lib/emoji-mark.ts`）。
  emojiMark String?


  // ===== 状态字段（5.3 单一事实来源，禁止再造冗余态）=====
  printCount       Int       @default(0)  // 打印次数（深挖纸），只显不改（#10 / T4）
  /// 【2026-09-30】复练纸印刷次数。与 `printCount` **分开记**：
  /// 两种纸用途不同（深挖=反思、复练=熟练），混成一个数就看不出这题是深挖过还是复练过。
  /// 记法：印一次复练卷 ⇒ 卷内所有题各 +1（见 mark-printed 的 kind=review）。
  reviewPrintCount Int       @default(0)
  attention        Int       @default(1)  // 关注档 1-5，语义=难度档（G8 / T5）
  /// 【2026-09-30】**复习结果**（错题卡底部那四个圆圈的原材料）。
  /// 形状（JSON）：`{"planned":["right",null,null],"last":"wrong"}`
  ///   · `planned[0..2]` = 第 1 / 7 / 21 天三次**计划**复习的结果，null = 还没结果
  ///   · `last`          = **最近一次**复习的结果（计划内、计划外都算）
  /// 规则只在一处实现：`src/lib/review-outcomes.ts`（计划内做完 ⇒ last 同步成同一结果；
  /// 计划外只动 last，前三个不动）。本轮只显示，录入入口等深挖纸回录链路。
  reviewOutcomes   String?
  /// 【2026-10-03】**等级账本**（等级 × 复习结果联动的内存）。
  ///
  /// 形状（JSON）：`{"slot":"p2","delta":1}` —— **只记最新一笔、且只记计划三格**。
  ///   · 等级是"一本账"：只有**新发生的事**才记账，翻旧账不记账；
  ///   · 只有**最新那一格**允许反悔 ⇒ 更早的账永远撤不掉 ⇒ 不必留；
  ///   · "最近一次复习"那一格**不进账本**（它按"一次输入"记，见 `lib/level-linkage.ts`）。
  ///
  /// ⚠️ 规则只在一处实现：`src/lib/level-linkage.ts`。别在别处算等级加减。
  levelLedger      String?
  /// 【2026-10-01】「深挖了还没印」提醒**手动按掉**的标记。
  /// 条件（类型=deep 且 printCount=0）成立且本列为 false 时：卡片左下打印机图标上色、
  /// 详情页计数黄底。印过一次（printCount>0）自动解除；详情页双击计数置 true。
  /// ⚠️ **类型被改动时复位**（新一轮就别再沿用上次的"我知道了"）。
  deepNudgeDismissed Boolean @default(false)
  redoCount        Int       @default(0)  // 复做计次，扫码复做 +1（H1 不闭环 / T7）
  mergeSource      String?               // 合并来源原题号组（#14 / T6）
  deletedAt        DateTime?             // 软删标记，非空=在回收箱（H2 / T2）
  lastPrintedAt    DateTime?             // 最近打印时间（#10）
  inputMethod      String?               // 录入方式: photo(拍照) / album(相册) / manual(手动)（H4）
                                          // ⚠️ 与上面 source(试卷来源) 不是一回事，勿混用

  /// 【M0 增补 → M3 落地】框坐标落库（P7「存坐标、不烧像素」）。
  /// 形状：
  ///   {"boxes":[{"kind":"scope|question|handwriting|figure","x":..,"y":..,"w":..,"h":..}],
  ///    "base":{"w":..,"h":..,"rotation":0|90|180|270}}
  /// kind 四种对应录入时的四色框：scope=绿（作用域）/ question=红（题干）/
  /// handwriting=蓝（她的手写）/ figure=橙（题图，不可 OCR）。取值见 src/lib/crop-regions.ts。
  ///
  /// ⚠️ 坐标**必须连基准图宽高 + 旋转一起存**（`base`）：图片一旦旋转或拉伸，坐标系就换了。
  ///    只存 x/y/w/h、不存基准尺寸，迟到一次旋转就会「不报错、只画错」
  ///    （同 image-cropper.tsx 的 rectSpaceStaleRef 教训：宁可没标记，也不要错的框）。
  ///
  /// 存坐标而不是把框烧进像素的收益：一张原图 + 一份坐标可派生
  /// **正面图 / 净版 / 题图 / OCR 输入** 四种视图，且原图永远干净。
  /// 反面印的「净版」= 按 handwriting / figure 的坐标涂白（M2 主路，确定性操作）。
  cropRegions      String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reviewSchedules ReviewSchedule[]
  printJobs       PrintJob[]        // 该题的每一次打印（同一题会重印多次，见 PrintJob）
  stateChangeLogs StateChangeLog[]  // 状态变更日志（R15）
  /// 【T2/T3 2026-09-28】这道题被编进过哪些卷（可空关系：题删了卷里那一行仍在，只是断了链）
  volumeItems     ReviewVolumeItem[]
  /// 【2026-10-01 改】日积月累与题的关联**不再走外键**，改存**题号**（`Insight.errorItemNo`）：
  /// 好处是"题被彻底删掉，积累条目还挂着题号"（去回收箱都能找回、导出 Obsidian 双链也认它），
  /// 坏处是没有级联 —— 但这正是要的效果（题没了话还在）。

  @@index([notebookId])
  @@index([deletedAt])
  @@index([userId, createdAt])
}

model ReviewSchedule {
  id          String    @id @default(cuid())
  errorItemId String
  errorItem   ErrorItem @relation(fields: [errorItemId], references: [id], onDelete: Cascade)

  /// 【M0 新增】第几轮独立检查（R14：1 = 第 0 天首次深挖 / 2 = 第 7 天 / 3 = 第 21 天）。
  /// ⚠️ 刻意**不加** @@unique([errorItemId, round])：存量数据由 /api/import 写入，
  /// 其去重口径是「同一 errorItem + 相同 scheduledFor」（import/route.ts:341 用 findFirst 而非 upset 去重），
  /// 说明库里可能存在同题多条记录。加唯一约束会让 SQLite 重建整表，风险大于收益。
  /// 唯一性改由 M7 的写入侧保证。
  round       Int       @default(1)

  scheduledFor DateTime
  completedAt  DateTime?
  isCorrect    Boolean? // Result of the review

  /// 【M0 新增】该轮用哪张纸（第 7 / 21 天走 T0 极简重做卡），以及她做完扫回来的那一面
  printJobId   String?
  scanReturnId String?

  createdAt    DateTime @default(now())

  @@index([errorItemId, round])
  @@index([scheduledFor])
}

model PracticeRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subject   String?  // e.g. "Math", "Physics"
  difficulty String? // "easy", "medium", "hard", "harder"
  isCorrect Boolean?
  
  createdAt DateTime @default(now())
}

// ============================================================================
// 【M0 · 2026-09-24】纸面回流链的数据底座（设计依据：打印结论 P19–P25）
//
// 为什么需要这一组表：
// 旧模型只有 ErrorItem.printCount 一个计数器 —— 知道"这题印过 3 次"，
// 却**不知道每一张纸各自是什么**。而新规范要求二维码里带"第几次打印 + 哪一面"
// （P25.1，如 SX20260916001-R2-B），扫回来还要落到具体的某一面纸上。
// 计数器做不到这件事，所以要补"打印实例"这一层。
//
// 依赖方向：PrintBatch（一批交付）→ PrintJob（一次打印）→ ScanReturn（扫回来的一面）。
// ============================================================================

/// 打印批次：一次交付即一批（P23 / R4：hill 的动作永远可分批）。
model PrintBatch {
  id          String @id @default(cuid())

  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 本批是否含 T5 回信页（回信随下一批卡交付，R7）
  hasReplyPage Boolean @default(false)

  /// 本批题数（冗余列，供列表直显；以 printJobs 关系为权威）
  itemCount   Int      @default(0)

  printedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  printJobs   PrintJob[]

  @@index([userId, printedAt])
}

/// 打印实例：一道题每被打印一次，产生一条。
model PrintJob {
  id          String    @id @default(cuid())

  errorItemId String
  errorItem   ErrorItem @relation(fields: [errorItemId], references: [id], onDelete: Cascade)

  /// 题号快照（= ErrorItem.source，如 SX20260916001）。二维码里印的就是它。
  /// 存快照的理由：合并错题会改 source（api/error-items/merge），
  /// 日后核对"当年那张纸上印的是什么"只能靠快照。
  questionNo  String

  /// 该题第几次打印：R1 / R2 / R3 …
  /// ⚠️ 与 ErrorItem.printCount 的关系：printCount 是"计数缓存"，本列是权威。
  /// 建实例时两者在**同一事务内**同步递增，避免漂移。
  instanceNo  Int

  /// 纸型（T1–T5）：本轮只实现 T1 深挖纸；T0 极简重做卡（第 7/21 天）预留
  paperType   String @default("T1")

  /// 这一张纸的用途：initial(第 0 天首次深挖) / day7 / day21
  /// ⚠️ 与 paperType 分开：T0 既能用于 day7 也能用于 day21，两者不是一回事
  stage       String @default("initial")

  batchId     String?
  batch       PrintBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  printedAt   DateTime @default(now())

  /// 回收状态。软件**只记它确实知道的两件事**：
  ///   printed  = 已打印（纸进了待做匣。她做没做，软件不猜 —— R16 不监控）
  ///   returned = 已回收（hill 扫回来了。R18：没她痕迹的纸不扫，也就不会有这条流转）
  /// 中间的"她正在做"刻意不存在。
  status      String @default("printed")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scanReturns ScanReturn[]

  /// 同一题的同一实例号只能有一条
  @@unique([errorItemId, instanceNo])
  @@index([batchId])
  @@index([status])
}

/// 回收件：扫描回来的**一面**纸（P25：两面各印一个码，故按面分别入库）。
model ScanReturn {
  id         String   @id @default(cuid())

  printJobId String
  printJob   PrintJob @relation(fields: [printJobId], references: [id], onDelete: Cascade)

  /// 哪一面：F = 正面（反思面）/ B = 背面（重做面）
  side       String

  /// 扫描件地址。**原件优先**（R17：AI 优先看扫描图，OCR 只是省力副本）
  imageUrl   String
  ocrText    String?

  scannedAt  DateTime @default(now())

  /// AI 判定结果（波 3 才写入，M0 只建位）
  aiVerdict  String?  // 已掌握 / 仍有错 / 无法判定
  aiPayload  String?  // 结构化原始结果（JSON 字符串）

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// 同一实例的同一面只应有一条。
  /// 重复扫到同一面时**撞唯一约束报错**，而不是静默覆盖 ——
  /// 正是 P25.5 要求的"报警交人确认，不做静默覆盖"。
  /// （污损重扫的更新路径留给波 2）
  @@unique([printJobId, side])
  @@index([printJobId])
}

/// 状态变更日志（R15）：哪道题、什么时候、被谁、标成了什么。
/// 原则：记**状态变更**，不记学习行为；按需查，不做全量监控（R16）。
model StateChangeLog {
  id           String    @id @default(cuid())

  errorItemId  String
  errorItem    ErrorItem @relation(fields: [errorItemId], references: [id], onDelete: Cascade)

  /// 变更的字段：masteryLevel / deletedAt / mistakeCategory …
  field        String
  fromValue    String?
  toValue      String?

  /// 谁改的：user / ai / scan / system
  actor        String
  actorUserId  String?

  /// 追到是哪张纸触发的（可空：在电脑上手动勾选就没有纸）
  printJobId   String?
  scanReturnId String?

  note         String?
  createdAt    DateTime @default(now())

  @@index([errorItemId, createdAt])
  @@index([actor, createdAt])
}

// ===========================================================================
// 【T2/T3 · 2026-09-28】卷（复练卷 RE… / 积累卷 BU…）
//
// 为什么**单独建表**，而不是把"复练纸"当成一个特殊错题本：
//   错题本的核心假设是「本里装的是**题**」——列表、统计、打印、扫码、导出
//   全都建立在这一条上。而卷里装的是「**一次编排**」（哪几题、什么顺序、
//   每道留多少行、共几页）。硬塞进错题本，上面每一处都得加一层特判，
//   而这个特判会跟着项目一直长下去。
//   卷需要一个自己的落脚点 —— 就是下面这两张表。
// ===========================================================================

/// 一张卷。
model ReviewVolume {
  id            String   @id @default(cuid())

  /// 卷号：`RE20260926001` / `BU20260926001`。
  /// 拼法与解析**只允许**在 `src/lib/volume-code.ts` 一处实现。
  volumeNo      String   @unique

  /// review（复练）| build（积累）
  kind          String

  /// 学期标签（如 `2026-秋`）—— 他要"按学期翻卷"。
  /// ⚠️ 是**标签**，不是分表依据：一个字段就够，不需要真按学期建多张表。
  semester      String

  /// 页眉上那句"年级·学期"（整卷一个值；组卷时的快照）
  gradeSemester String?

  /// 总页数（组卷时按分页算法算出来的快照）——印在页眉"第X/Y页"的那个 Y
  pageCount     Int      @default(0)

  /// 组这份卷时的默认留白行数（复练 5 / 积累 1）
  defaultBlankLines Int  @default(5)

  /// 【2026-09-30】卷的**名字**（自取，如"第五单元 复练"）。
  /// 只存在库里、**不上纸** —— 纸面的身份是卷号（页眉 + 页二维码都是它），
  /// 页眉那一行已经排满（阳文框 / 卷号 / 年级学期 / 页码 / 印于 / 二维码），
  /// 再塞一个名字只会变挤。名字的用途是"他在管理页里找卷、认卷"。
  title         String?

  /// 【2026-10-03 需求第 10 条】**这份卷的随机 emoji 标识**（印在页眉"印于"左边）。
  ///
  /// 复练卷 / 积累纸**每页都有印刷时间**，他要求这一份的**所有页共用同一个**符号
  /// ⇒ 存在**卷**上（而不是每页各一个）。NULL 时惰性生成一次并写回；
  /// 已有值就直接用 —— 这就是"同一份纸的符号相对不变"。
  /// 取值只能来自 `src/lib/emoji-print-library.json`（等概率随机，见 `lib/emoji-mark.ts`）。
  emojiMark     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items         ReviewVolumeItem[]

  @@index([kind, createdAt])
  @@index([semester])
}

/// 卷里的一道题。
///
/// ⚠️ **几乎全是快照**，这是刻意的 —— 回答"题被删了、卷会怎样"：
///    卷是**印出去的凭证**，必须能像当初印的那样重新打开。
///    如果只存一个外键，那么题一改，历史卷跟着变（历史被篡改），
///    题一删，卷上就出现空洞甚至整卷打不开。
///    所以：`errorItemId` 只是"还能点回去看看"的软链接，
///    真正用来渲染的是 `itemNo / questionText / figureUrls / blankLines` 这几个快照。
model ReviewVolumeItem {
  id           String       @id @default(cuid())

  volumeId     String
  volume       ReviewVolume @relation(fields: [volumeId], references: [id], onDelete: Cascade)

  /// 这份卷里的流水号（1 起）—— 只是这份卷对题的排序号，不是题号
  seqInVolume  Int
  /// 排在第几页（1 起）
  pageIndex    Int
  /// 第几栏（0 起；复练纸恒为 0）
  columnIndex  Int          @default(0)
  /// 栏内第几块（1 起）
  seqInColumn  Int          @default(1)

  /// 原题（可空：题被删 ⇒ 置空，但**卷照常能打开**）
  errorItemId  String?
  errorItem    ErrorItem?   @relation(fields: [errorItemId], references: [id], onDelete: SetNull)

  /// 【2026-10-01 第三轮：积累纸】这条是**哪条日积月累**（软链接，用来跳回原条目）。
  /// 与 errorItemId **互斥**：复练卷的行挂题，积累卷的行挂积累条目。
  /// ⚠️ 只是软链接 —— **纸面的一切都走下面的快照**（定盘星：印出去的凭证存快照）。
  insightId    String?
  insight      Insight?     @relation(fields: [insightId], references: [id], onDelete: SetNull)

  /// 【复练卷】题号快照（= ErrorItem.source，如 SX20260916001）
  /// 【积累卷】**JL 编号快照**（如 JL20261001001）—— 同一个槽位，装的是这条内容的"编号"。
  /// 语义一致：都是纸上印的那个号，所以复用一列而不新开。
  itemNo       String?
  /// 【复练卷】题干快照（OCR 文字）
  /// 【积累卷】**积累正文快照**（md 源）—— 同上，复用一列。
  questionText String?
  /// 【复练卷】题图快照（JSON 数组，元素是 dataURL 或路径）
  /// 【积累卷】**积累配图快照**（同上格式；一条最多一张，规则是他定的）
  figureUrls   String?
  /// 印这一刻这道题的错题等级（决定那是"↑升级"还是"↓降级"小框）
  manageType   String?

  /// 这道题的留白行数（可逐题调；整体调整的规则见 `applyGlobalBlankLines`）
  blankLines   Int          @default(5)

  /// 这道题的**题图缩放百分比**（100 = 版面默认）。2026-09-29 加。
  /// ⚠️ 必须进快照：他在预览里拖过把手就把大小改了，「更新组卷」要能把它一起存回来，
  ///    否则下次打开又变回默认（"我调过的图又跑回去了"）。
  figureScale  Int          @default(100)

  /// 【2026-10-02】**这份卷上**这道题的标记（扫码页那颗三态圆的持久态）：
  ///   `null` = 还没标 / 已撤销　`'right'` = 对　`'wrong'` = 错
  ///
  /// ⚠️ 为什么记在**卷的行**上，而不是只写题目的 `reviewOutcomes`：
  ///    他 2026-10-02 明确要求 ——"如果扫的是另外一个没有扫描过的新卷，
  ///    即使有这道题**还是应该给灰圈**"。也就是说"标过没标过"是**这一卷上**发生过的事，
  ///    不该跟着题跑到别的卷里去。
  ///    （题目的 `reviewOutcomes` 照旧同步写 —— 那是**复习历史**，跨卷的属性，两者不冲突：
  ///      一个回答"这张纸上我标了什么"，一个回答"这道题复习过几次、结果如何"。）
  markState    String?

  createdAt    DateTime     @default(now())

  @@index([volumeId])
  @@index([errorItemId])
}

/// 【2026-10-01 新增】**日积月累**（Insight）—— 从这道题攒下来的一句人话。
///
/// 与「错题」的区别（他 2026-09-30 的原话）：
///   错因分析 = AI 讲**这题错在哪**；日积月累 = **从这道题攒下的收获**。
/// 它是**另一种内容**，所以自立一张表 —— 这也是当初 `manageType` 只有
/// deep/review 两个值、没有第三档 "积累" 的原因（积累点背后可以没有错题行）。
///
/// 编号规则（他定的）：`JL` + `yyyymmdd`（**本地日期**）+ 三位当日流水（001 起），如 `JL20260930001`。
/// ⚠️ 日期段由**客户端**算好传上来（容器跑在 UTC，服务端自己分"天"会偏 8 小时，
///    与全项目的时区铁律一致）；服务端只负责"在这个日期段里发下一个流水号"。
model Insight {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 完整编号 JLyyyymmddxxx
  code    String
  /// 编号里的日期段 `YYYY-MM-DD`（本地日期）
  dateKey String
  /// 当日流水号，001 起
  seq     Int

  gradeSemester String?
  /// 学科（9 科 + 其他，取值见 lib/notebook-fields.ts 的 SUBJECT_OPTIONS）
  subject       String?
  /// 正文（md 源）
  content       String?

  /// 【2026-10-01 起，这是**正钥匙**】相关错题的**题号**（如 SX20260930001），不是内部 id。
  /// 存题号的两个理由：① 扫码/回录链路里手里只有题号，"按题号反查"才能做到
  ///    **送两次不重复建**（见下面 `@@unique([userId, errorItemNo])`）；② 将来导出成
  ///    Obsidian 双链，双链认的也是题号。题被删了这条积累**留着**
  ///    （题号还在，原题去回收箱也能找回）。
  ///
  /// ⚠️ **唯一索引为什么写成 `[userId, errorItemNo]` 而不是只写题号**：
  ///    SQLite（与 SQL 标准一致）在唯一索引里**把 NULL 当成互不相同的值** ——
  ///    所以"没关联错题的条目"（errorItemNo 为 NULL）可以有任意多条，
  ///    而"关联了某道题的条目"一人只能有一条。**正是要的效果，不需要部分索引。**
  ///    （一开始我写成了 SQLite 特有的 `WHERE errorItemNo IS NOT NULL` 部分索引，
  ///     那样既跨不了库、又因为 schema 里表达不出来而会被下次 migrate 当成多余索引删掉 —— 已改。）
  ///    另外必须带 userId：只按题号唯一的话，两个用户录到同一题号会互相撞。
  errorItemNo String?

  /// 这条从哪来的：question（错题送）/ page（日积月累页建）/ external（外部送，留口子）
  source String?

  /// ⚠️【2026-10-01 起弃用·保留列】原来存错题内部 id + 图片 data URL。
  /// 弃用原因见迁移 20261001200000：按学期/题号检索时被迫把图片一起搬进内存（"字典每页贴照片"）。
  /// 图片已搬到 `InsightPhoto`；关联改用 `errorItemNo`（题号）。老数据已回填，新代码不再写这两列。
  errorItemId String?
  photoUrl    String?

  /// 配图（**最多一张**，本体在 `InsightPhoto` 表，主表查询完全不碰它）
  photo InsightPhoto?

  /// 【2026-10-01 第三轮】这条被印进过哪些卷（软链接，用来从纸上跳回这里）。
  /// 卷里那一行存的是**快照**，所以删掉这条不影响已经印出去的纸（定盘星）。
  volumeItems ReviewVolumeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, code])
  @@unique([userId, dateKey, seq])
  /// 一题一条（他定的规则）：关联了某道题的积累条目，同一人只能有一条 ⇒ 送两次是覆盖不是新建。
  /// 没关联错题的（errorItemNo 为 NULL）不受限，可以随便建 —— 理由见 errorItemNo 的注释。
  @@unique([userId, errorItemNo])
  @@index([userId, createdAt])
  @@index([errorItemId])
}

/// 【2026-10-01】日积月累的**配图**（一张积累最多一张图，他定的规则）。
///
/// 为什么单独一张表：正文是几 KB 的文字，图片是几百 KB 的 data URL ——
/// 挤在同一行里，**每次列表查询都被迫把所有照片一起搬进内存**
/// （"字典每一页都贴了照片，只想查一个词也得整页翻"）。
/// 分表之后主表查询完全不碰它，"加一条"和"加一万条"手感一样。
/// 将来若导出到 Obsidian（图片要落成文件），只改这一处的读写。
model InsightPhoto {
  id        String   @id @default(cuid())
  insightId String
  insight   Insight  @relation(fields: [insightId], references: [id], onDelete: Cascade)
  /// 图片本体（data URL）
  data      String
  createdAt DateTime @default(now())

  @@unique([insightId])
}
